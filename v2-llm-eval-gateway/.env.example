# mock = fake answers + fake embeddings, free, no AWS needed.
# bedrock = real Bedrock calls (costs a little, paid from AWS credits).
LLM_MODE=mock
AWS_REGION=us-east-1
ACTIVE_MODEL=amazon.nova-micro-v1:0
EMBED_MODEL=amazon.titan-embed-text-v2:0
# Password for /admin. Leave empty to switch the admin API off.
ADMIN_PASSWORD=change-me
# Models compared by the evaluation, and the judge (must not be a candidate).
CANDIDATE_MODELS=amazon.nova-micro-v1:0,amazon.nova-lite-v1:0,amazon.nova-pro-v1:0
JUDGE_MODEL=amazon.nova-premier-v1:0
